# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# Data Directories & Heavy Artifacts (Do NOT commit raw or processed datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/temp/
*.osm.pbf
*.pbf
*.zip
*.mapdb*
*.db
*.db.wal


build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Logs
.pytest_cache/
.coverage
htmlcov/
*.log
hs_err_pid*.log

# Editor & AI IDE Configurations
.agents/
.gemini/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
